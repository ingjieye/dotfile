#!/usr/bin/env bash
set -u

STATUS_SCRIPT="/Users/yeyj/bin/tmux-agent-hook/bin/tmux-agent-status"
CODEX_BIN="${CODEX_BIN:-/opt/homebrew/bin/codex}"
CLEANED_UP=0

cleanup() {
  if [ "$CLEANED_UP" -eq 1 ]; then
    return
  fi
  CLEANED_UP=1
  "$STATUS_SCRIPT" clear >/dev/null 2>&1 || true
}

on_signal() {
  cleanup
  trap - INT TERM HUP
  exit 130
}

trap cleanup EXIT
trap on_signal INT TERM HUP

args=("$@")
has_alt_screen_flag=0
for a in "${args[@]}"; do
  if [ "$a" = "--no-alt-screen" ]; then
    has_alt_screen_flag=1
    break
  fi
done
if [ "$has_alt_screen_flag" -eq 0 ]; then
  args=("--no-alt-screen" "${args[@]}")
fi

"$CODEX_BIN" "${args[@]}"
status=$?
cleanup
exit "$status"
