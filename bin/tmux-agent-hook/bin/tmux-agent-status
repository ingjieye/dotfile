#!/usr/bin/env python3
"""Update tmux window and session names from agent lifecycle hooks."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import subprocess
import sys
from pathlib import Path
from dataclasses import dataclass


RUNNING_PREFIX = "⌛️"
DONE_PREFIX = "☑️"
STATUS_PREFIXES = (RUNNING_PREFIX, "⌛", DONE_PREFIX, "☑")

RUNNING_EVENTS = {"UserPromptSubmit", "user_prompt_submit"}
DONE_EVENTS = {
    "Stop",
    "StopFailure",
    "TaskCompleted",
    "stop",
    "stop_failure",
}
SUBAGENT_START_EVENTS = {"SubagentStart", "subagent_start"}
SUBAGENT_STOP_EVENTS = {"SubagentStop", "subagent_stop"}
CLEAR_EVENTS = {"SessionEnd", "session_end"}
STATE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "tmux-agent-hook"
STATE_FILE = STATE_DIR / "state.json"
LOCK_FILE = STATE_DIR / "state.lock"


@dataclass(frozen=True)
class TmuxTarget:
    pane_id: str
    session_id: str
    session_name: str
    window_id: str
    window_name: str


@dataclass(frozen=True)
class LivePane:
    session_id: str
    window_id: str


@dataclass(frozen=True)
class WindowInfo:
    session_id: str
    window_name: str


@dataclass(frozen=True)
class SessionInfo:
    session_name: str


def strip_status_prefix(name: str) -> str:
    result = name
    changed = True
    while changed:
        changed = False
        for prefix in STATUS_PREFIXES:
            if result.startswith(prefix):
                result = result[len(prefix) :].lstrip()
                changed = True
                break
    return result


def prefixed_name(name: str, prefix: str) -> str:
    return prefix + strip_status_prefix(name)


def name_status(name: str) -> str | None:
    if name.startswith((RUNNING_PREFIX, "⌛")):
        return "running"
    if name.startswith((DONE_PREFIX, "☑")):
        return "done"
    return None


def session_prefix_for_window_names(window_names: list[str]) -> str | None:
    statuses = {name_status(name) for name in window_names}
    if "running" in statuses:
        return RUNNING_PREFIX
    if "done" in statuses:
        return DONE_PREFIX
    return None


def prefix_for_statuses(statuses: list[str]) -> str | None:
    if "running" in statuses:
        return RUNNING_PREFIX
    if "done" in statuses:
        return DONE_PREFIX
    return None


def action_from_event(event_name: str | None) -> str | None:
    if not event_name:
        return None
    if event_name in RUNNING_EVENTS:
        return "mark-running"
    if event_name in SUBAGENT_START_EVENTS:
        return "subagent-start"
    if event_name in SUBAGENT_STOP_EVENTS:
        return "subagent-stop"
    if event_name in DONE_EVENTS:
        return "mark-done"
    if event_name in CLEAR_EVENTS:
        return "clear"
    return None


def read_hook_event(stdin_text: str) -> str | None:
    if not stdin_text.strip():
        return None
    try:
        payload = json.loads(stdin_text)
    except json.JSONDecodeError:
        return None
    return (
        payload.get("hook_event_name")
        or payload.get("hookEventName")
        or payload.get("hook_event")
    )


def run_tmux(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["tmux", *args],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )


def normalize_pane_id(pane_id: str) -> str:
    pane_id = pane_id.strip()
    if pane_id and pane_id[0].isdigit():
        return "%" + pane_id
    return pane_id


def default_pane_id() -> str:
    pane_id = normalize_pane_id(os.environ.get("TMUX_PANE", ""))
    if pane_id:
        return pane_id
    if not os.environ.get("TMUX"):
        return ""

    result = run_tmux(["display-message", "-p", "#{pane_id}"])
    if result.returncode != 0:
        return ""
    return normalize_pane_id(result.stdout)


def get_tmux_target(pane_id: str) -> TmuxTarget | None:
    result = run_tmux(
        [
            "display-message",
            "-p",
            "-t",
            pane_id,
            "#{session_id}\t#{session_name}\t#{window_id}\t#{window_name}",
        ]
    )
    if result.returncode != 0:
        return None
    line = result.stdout.rstrip("\n")
    parts = line.split("\t", 3)
    if len(parts) != 4:
        return None
    session_id, session_name, window_id, window_name = parts
    if not session_id or not window_id:
        return None
    return TmuxTarget(
        pane_id=pane_id,
        session_id=session_id,
        session_name=session_name,
        window_id=window_id,
        window_name=window_name,
    )


def list_live_panes() -> dict[str, LivePane]:
    result = run_tmux(["list-panes", "-a", "-F", "#{pane_id}\t#{session_id}\t#{window_id}"])
    if result.returncode != 0:
        return {}

    panes: dict[str, LivePane] = {}
    for line in result.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        pane_id, session_id, window_id = parts
        panes[pane_id] = LivePane(session_id=session_id, window_id=window_id)
    return panes


def list_window_names(session_id: str) -> list[str] | None:
    result = run_tmux(["list-windows", "-t", session_id, "-F", "#{window_name}"])
    if result.returncode != 0:
        return None
    return result.stdout.splitlines()


def list_windows() -> dict[str, WindowInfo]:
    result = run_tmux(
        ["list-windows", "-a", "-F", "#{window_id}\t#{session_id}\t#{window_name}"]
    )
    if result.returncode != 0:
        return {}

    windows: dict[str, WindowInfo] = {}
    for line in result.stdout.splitlines():
        parts = line.split("\t", 2)
        if len(parts) != 3:
            continue
        window_id, session_id, window_name = parts
        windows[window_id] = WindowInfo(session_id=session_id, window_name=window_name)
    return windows


def list_sessions() -> dict[str, SessionInfo]:
    result = run_tmux(["list-sessions", "-F", "#{session_id}\t#{session_name}"])
    if result.returncode != 0:
        return {}

    sessions: dict[str, SessionInfo] = {}
    for line in result.stdout.splitlines():
        parts = line.split("\t", 1)
        if len(parts) != 2:
            continue
        session_id, session_name = parts
        sessions[session_id] = SessionInfo(session_name=session_name)
    return sessions


def rename_window(window_id: str, new_name: str) -> bool:
    result = subprocess.run(
        ["tmux", "rename-window", "-t", window_id, new_name],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def rename_session(session_id: str, new_name: str) -> bool:
    result = subprocess.run(
        ["tmux", "rename-session", "-t", session_id, new_name],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def list_tmux_clients() -> list[str]:
    result = run_tmux(["list-clients", "-F", "#{client_name}"])
    if result.returncode != 0:
        return []
    return [line for line in result.stdout.splitlines() if line]


def refresh_tmux_status_line() -> None:
    clients = list_tmux_clients()
    if not clients:
        run_tmux(["refresh-client", "-S"])
        return

    for client in clients:
        run_tmux(["refresh-client", "-S", "-t", client])


def refresh_session_prefix(session_id: str, session_name: str) -> bool:
    window_names = list_window_names(session_id)
    if window_names is None:
        return True

    prefix = session_prefix_for_window_names(window_names)
    if prefix is None:
        new_name = strip_status_prefix(session_name)
    else:
        new_name = prefixed_name(session_name, prefix)

    if new_name == session_name:
        return True
    return rename_session(session_id, new_name)


def load_state() -> dict:
    if not STATE_FILE.exists():
        return {"panes": {}}
    try:
        state = json.loads(STATE_FILE.read_text())
    except (OSError, json.JSONDecodeError):
        return {"panes": {}}
    if not isinstance(state, dict):
        return {"panes": {}}
    panes = state.get("panes")
    if not isinstance(panes, dict):
        state["panes"] = {}
    return state


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, sort_keys=True) + "\n")
    tmp.replace(STATE_FILE)


def add_affected_ids(
    window_ids: set[str],
    session_ids: set[str],
    window_id: str | None,
    session_id: str | None,
) -> None:
    if window_id:
        window_ids.add(window_id)
    if session_id:
        session_ids.add(session_id)


def sync_state_with_live_panes(
    state: dict, live_panes: dict[str, LivePane]
) -> tuple[set[str], set[str]]:
    panes = state.setdefault("panes", {})
    affected_window_ids: set[str] = set()
    affected_session_ids: set[str] = set()

    for pane_id in list(panes):
        entry = panes[pane_id]
        if not isinstance(entry, dict):
            panes.pop(pane_id, None)
            continue

        add_affected_ids(
            affected_window_ids,
            affected_session_ids,
            entry.get("window_id"),
            entry.get("session_id"),
        )

        live_pane = live_panes.get(pane_id)
        if live_pane is None:
            panes.pop(pane_id, None)
            continue

        entry["session_id"] = live_pane.session_id
        entry["window_id"] = live_pane.window_id
        add_affected_ids(
            affected_window_ids,
            affected_session_ids,
            live_pane.window_id,
            live_pane.session_id,
        )

    return affected_window_ids, affected_session_ids


def apply_state_action(action: str, target: TmuxTarget, state: dict) -> None:
    panes = state.setdefault("panes", {})
    if action == "mark-running":
        panes[target.pane_id] = {
            "session_id": target.session_id,
            "window_id": target.window_id,
            "status": "running",
            "active_subagents": 0,
        }
    elif action == "subagent-start":
        entry = panes.setdefault(
            target.pane_id,
            {
                "session_id": target.session_id,
                "window_id": target.window_id,
                "status": "running",
                "active_subagents": 0,
            },
        )
        entry["active_subagents"] = entry.get("active_subagents", 0) + 1
    elif action == "subagent-stop":
        entry = panes.get(target.pane_id)
        if entry is not None:
            entry["active_subagents"] = max(0, entry.get("active_subagents", 0) - 1)
    elif action == "mark-done":
        entry = panes.get(target.pane_id)
        if entry is not None and entry.get("active_subagents", 0) > 0:
            # A background subagent is still running; the turn only looked
            # idle. Keep the pane marked running until it truly finishes.
            return
        panes[target.pane_id] = {
            "session_id": target.session_id,
            "window_id": target.window_id,
            "status": "done",
        }
    elif action in {"mark-interrupted", "clear"}:
        panes.pop(target.pane_id, None)


def update_state(action: str, target: TmuxTarget) -> tuple[dict, set[str], set[str]]:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_state()
        live_panes = list_live_panes()
        affected_window_ids, affected_session_ids = sync_state_with_live_panes(
            state, live_panes
        )
        add_affected_ids(
            affected_window_ids,
            affected_session_ids,
            target.window_id,
            target.session_id,
        )
        apply_state_action(action, target, state)
        save_state(state)
        return state, affected_window_ids, affected_session_ids


def refresh_state() -> tuple[dict, set[str], set[str]]:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load_state()
        live_panes = list_live_panes()
        affected_window_ids, affected_session_ids = sync_state_with_live_panes(
            state, live_panes
        )
        save_state(state)
        return state, affected_window_ids, affected_session_ids


def statuses_for_window(state: dict, window_id: str) -> list[str]:
    return [
        entry.get("status", "")
        for entry in state.get("panes", {}).values()
        if isinstance(entry, dict) and entry.get("window_id") == window_id
    ]


def statuses_for_session(state: dict, session_id: str) -> list[str]:
    return [
        entry.get("status", "")
        for entry in state.get("panes", {}).values()
        if isinstance(entry, dict) and entry.get("session_id") == session_id
    ]


def agent_status_counts(state: dict) -> tuple[int, int]:
    running = 0
    done = 0

    for entry in state.get("panes", {}).values():
        if not isinstance(entry, dict):
            continue
        status = entry.get("status")
        if status == "running":
            running += 1
        elif status == "done":
            done += 1

    return running, done


def format_agent_status(state: dict) -> str:
    running, done = agent_status_counts(state)
    return f"{RUNNING_PREFIX}{running} {DONE_PREFIX}{done}"


def desired_name_from_prefix(current_name: str, prefix: str | None) -> str:
    if prefix is None:
        return strip_status_prefix(current_name)
    return prefixed_name(current_name, prefix)


def refresh_names(
    state: dict, affected_window_ids: set[str], affected_session_ids: set[str]
) -> None:
    windows = list_windows()
    sessions = list_sessions()

    for window_id in sorted(affected_window_ids):
        window = windows.get(window_id)
        if window is None:
            continue
        new_window_name = desired_name_from_prefix(
            window.window_name,
            prefix_for_statuses(statuses_for_window(state, window_id)),
        )
        if new_window_name != window.window_name:
            rename_window(window_id, new_window_name)

    for session_id in sorted(affected_session_ids):
        session = sessions.get(session_id)
        if session is None:
            continue
        new_session_name = desired_name_from_prefix(
            session.session_name,
            prefix_for_statuses(statuses_for_session(state, session_id)),
        )
        if new_session_name != session.session_name:
            rename_session(session_id, new_session_name)


def apply_refresh() -> int:
    state, affected_window_ids, affected_session_ids = refresh_state()
    refresh_names(state, affected_window_ids, affected_session_ids)
    refresh_tmux_status_line()
    return 0


def print_status_right() -> int:
    print(format_agent_status(load_state()))
    return 0


def apply_action(action: str, pane_id: str) -> int:
    target = get_tmux_target(pane_id)
    if target is None:
        return 0

    if action not in {
        "mark-running",
        "mark-done",
        "mark-interrupted",
        "subagent-start",
        "subagent-stop",
        "clear",
    }:
        return 2

    state, affected_window_ids, affected_session_ids = update_state(action, target)
    refresh_names(state, affected_window_ids, affected_session_ids)
    refresh_tmux_status_line()
    return 0


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Mark the tmux window and session that own the current agent pane."
    )
    parser.add_argument(
        "action",
        nargs="?",
        choices=[
            "hook",
            "mark-running",
            "mark-done",
            "mark-interrupted",
            "subagent-start",
            "subagent-stop",
            "clear",
            "refresh",
            "status-right",
        ],
        default="hook",
        help="Action to apply. 'hook' derives the action from hook JSON stdin.",
    )
    parser.add_argument(
        "--pane",
        default="",
        help="tmux pane id. Defaults to TMUX_PANE or the current tmux pane.",
    )
    parser.add_argument(
        "--event",
        default="",
        help="Hook event name used when action is 'hook'.",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    args = parse_args(argv)

    action = args.action
    if action == "hook":
        stdin_text = "" if sys.stdin.isatty() else sys.stdin.read()
        action = action_from_event(args.event or read_hook_event(stdin_text)) or ""

    if not action:
        return 0

    if action == "refresh":
        return apply_refresh()

    if action == "status-right":
        return print_status_right()

    pane_id = normalize_pane_id(args.pane) or default_pane_id()
    if not pane_id:
        return 0

    return apply_action(action, pane_id)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
