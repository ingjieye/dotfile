Include /Users/yeyj/.colima/ssh_config

SetEnv TERM=xterm-256color

Include ~/.ssh/work_hosts
Include ~/.ssh/jenkins_hosts  
Include ~/.ssh/home_hosts

Host github.com
  HostName ssh.github.com
  Port 443
  User git

# 全局默认配置
Host *
  # 所有 ssh 统一经本机代理分流, 未运行时自动回退直连
  ProxyCommand nc -X connect -x 127.0.0.1:7890 %h %p 2>/dev/null || exec nc %h %p
  ServerAliveInterval 180
  HashKnownHosts no
  #AddressFamily inet
  Compression yes
  ControlMaster auto
  ControlPath /tmp/ssh_%r@%h:%p
  ControlPersist 2h
  ForwardAgent yes
  SendEnv LANG LC_ALL
